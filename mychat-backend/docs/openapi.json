{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Chat",
      "description": "API for managing chats and messages from a chat."
    }
  ],
  "paths": {
    "/chats": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Retrieve a list of all chats.",
        "description": "Retrieves a list of all chats, including their IDs and creation timestamps.",
        "operationId": "listChats",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatListItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Create a new chat with an initial message.",
        "description": "Creates a new chat and submits the initial message provided in the request body.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GetChatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{id}/messages": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Submits a new message to the chat specified by ID",
        "description": "Submits a new message to the chat specified by ID and returns the response message generated by the chat service.",
        "operationId": "sendMessage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the chat to which the message is being sent.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{id}": {
      "get": {
        "tags": [
          "Chat"
        ],
        "summary": "Retrieve a chat by its ID.",
        "description": "Retrieves the chat with the specified ID, including all messages associated with that chat.",
        "operationId": "findById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The ID of the chat to retrieve.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GetChatResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "description": "The request body containing the initial message for the new chat.",
        "properties": {
          "message": {
            "$ref": "#/components/schemas/MessageRequest",
            "description": "The initial message to be sent in the new chat.",
            "minLength": 1
          }
        },
        "required": [
          "message"
        ]
      },
      "MessageRequest": {
        "type": "object",
        "description": "The request body containing the message to be sent.",
        "properties": {
          "text": {
            "type": "string",
            "description": "The content of the message to be sent.",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ]
      },
      "GetChatResponse": {
        "type": "object",
        "description": "Response body for retrieving a chat, including its messages and creation timestamp.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The unique identifier of the chat.",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "The title of the chat."
          },
          "messages": {
            "type": "array",
            "description": "The list of messages associated with the chat.",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the chat was created.",
            "example": "2024-06-01T12:00:00Z"
          }
        },
        "required": [
          "createdAt",
          "id",
          "messages",
          "title"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "description": "Response body for retrieving a message, including its content and the timestamp when it was received.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The unique identifier of the message.",
            "example": 1
          },
          "text": {
            "type": "string",
            "description": "The content of the message.",
            "minLength": 1
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the message was received.",
            "example": "2024-06-01T12:00:00Z"
          }
        },
        "required": [
          "id",
          "receivedAt",
          "text"
        ]
      },
      "ChatListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}